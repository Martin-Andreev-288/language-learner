// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client-js"
    output   = "../app/generated/prisma"
}

datasource db {
    provider = "postgresql"
}

// Folder model - organises texts and dialogues into user folders
model Folder {
    id        String   @id @default(cuid())
    userId    String
    name      String
    order     Int
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // Relations
    user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
    texts Text[]

    @@index([userId])
    @@index([order])
}

// Text model - stores reading, writing, and dialogue sessions
model Text {
    id         String   @id @default(cuid())
    userId     String
    title      String?
    content    String   @db.Text
    language   String
    type       TextType
    newWords   Int      @default(0)
    totalWords Int      @default(0)
    folderId   String?
    createdAt  DateTime @default(now())

    // Relations
    user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
    folder Folder? @relation(fields: [folderId], references: [id], onDelete: Cascade)

    @@index([userId])
    @@index([folderId])
    @@index([language])
    @@index([type])
    @@index([createdAt])
}

// Enum for text type
enum TextType {
    reading
    writing
    dialogue
}

// VocabularyEntry model - tracks words encountered
model VocabularyEntry {
    id       String @id @default(cuid())
    userId   String
    word     String
    language String

    // AI-generated enrichment (Question 243). All nullable and all
    // independent — a word can have any subset of these, since the user
    // picks which ones to generate per batch. Plain strings rather than
    // arrays or a related model: they're only ever displayed and hand-
    // edited as text, so a list column would buy nothing and cost a join.
    // Multi-value fields (synonyms, examples, collocations) are stored
    // newline-separated, the same one-per-line convention this page's own
    // bulk word input already uses.
    level        String?
    // A noun's gender and plural, as one short inline chunk ("m, -e"), kept
    // out of `word` on purpose (Question 246): `word` is this row's
    // identity — it carries the unique constraint, it's what enrichment
    // matches AI results back onto, and it's what gets spoken aloud — so
    // decorating it would break dedup and pronunciation at once. Empty for
    // anything that isn't a noun.
    nounInfo     String?
    partOfSpeech String?
    wordFamily   String?
    synonyms     String?
    aiExamples   String?
    collocations String?

    // Added in Question 310.
    //
    // Where this word is actually met — one of a short fixed set (see
    // lib/vocabulary-enrichment.ts). Deliberately not the same axis as
    // `level`: level says how advanced a word is, this says which kind of
    // situation it belongs to, and a word can easily be easy and confined
    // to one trade, or hard and heard everywhere.
    //
    // Renamed from `worthLearning` in Question 316, when the values stopped
    // being a ranking and became contexts — nothing here outranks anything
    // else, so a name promising a verdict was a name that lied.
    usedIn     String?
    // The topic it belongs to, suggested from lib/word-categories.ts but
    // stored as plain text, so a category invented by hand is as valid as
    // one from the list.
    category   String?
    // A sentence the user wrote themselves, unlike `aiExamples`. The one
    // field here that never comes from the model — it can be checked by
    // one on request, but it is never generated.
    ownExample String?

    timesSeenReading Int      @default(0)
    timesSeenWriting Int      @default(0)
    firstSeen        DateTime @default(now())
    lastSeen         DateTime @updatedAt

    // Relations
    user         User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
    translations VocabularyTranslation[]

    // Unique constraint: one entry per word per language per user
    @@unique([userId, word, language])
    @@index([userId])
    @@index([language])
    @@index([word])
}

// VocabularyTranslation model - one row per word per target language
// (Question 326, Step 6a of Question 302).
//
// A separate table rather than more columns on VocabularyEntry, and rather
// than one delimited string, because this is the one piece of vocabulary
// data with a genuinely open set of values: a word can have a translation
// in any language, and which languages a person uses isn't knowable when
// the schema is written. Every other multi-value field here (synonyms,
// examples) is a plain newline-separated string precisely because it is
// only ever read as text — these are different, because "has a French
// translation" and "missing an Italian one" are questions to be asked of
// the data, not text to be displayed.
//
// It replaces nothing. VocabularyEntry.translation stays exactly as it is:
// whatever translation was on hand when the word was saved, with no
// language recorded for it (Question 214). A word with one translation and
// no interest in others keeps working without ever touching this table.
model VocabularyTranslation {
    id        String   @id @default(cuid())
    entryId   String
    // The language translated *into*, stored as one of the canonical names
    // in lib/language-codes.ts — the same spelling every language field in
    // this app writes, so "French" from here and "French" typed into the
    // word list are the same value and group together.
    language  String
    text      String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // Relations
    entry VocabularyEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

    // One translation per language per word: asking for French twice
    // updates the French row rather than growing a second one. This is also
    // what makes "fill in what's missing, never overwrite what's there" a
    // single skipDuplicates insert rather than a read-then-write.
    @@unique([entryId, language])
    @@index([entryId])
    @@index([language])
}

// ShuffleFolder model - organises shuffle lists into nested, user-created folders (unlimited depth)
model ShuffleFolder {
    id             String          @id @default(cuid())
    userId         String
    type           ShuffleListType
    name           String
    parentFolderId String?
    order          Int             @default(0)
    createdAt      DateTime        @default(now())
    updatedAt      DateTime        @updatedAt

    // Relations
    user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
    parentFolder ShuffleFolder?  @relation("ShuffleFolderHierarchy", fields: [parentFolderId], references: [id], onDelete: Cascade)
    childFolders ShuffleFolder[] @relation("ShuffleFolderHierarchy")
    lists        ShuffleList[]

    @@index([userId])
    @@index([userId, type])
    @@index([parentFolderId])
}

// ShuffleList model - stores user-created vocabulary/phrase lists for shuffle review
model ShuffleList {
    id             String          @id @default(cuid())
    userId         String
    type           ShuffleListType
    title          String
    reviewCount    Int             @default(0)
    lastReviewedAt DateTime?
    folderId       String?
    createdAt      DateTime        @default(now())
    updatedAt      DateTime        @updatedAt

    // Relations
    user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
    folder ShuffleFolder? @relation(fields: [folderId], references: [id], onDelete: Cascade)
    cards  ShuffleCard[]

    @@index([userId])
    @@index([userId, type])
    @@index([folderId])
    @@index([createdAt])
}

// ShuffleCard model - stores card review state inside a shuffle list
model ShuffleCard {
    id        String   @id @default(cuid())
    listId    String
    text      String   @db.Text
    memorized Boolean  @default(false)
    favorite  Boolean  @default(false)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // Relations
    list ShuffleList @relation(fields: [listId], references: [id], onDelete: Cascade)

    @@index([listId])
    @@index([memorized])
    @@index([favorite])
    @@index([createdAt])
}

// Enum for shuffle list types
enum ShuffleListType {
    word
    phrase
}

// NoteFolder model - organises notes into nested, user-created folders (unlimited depth),
// scoped per page the same way ShuffleFolder is scoped per ShuffleListType
model NoteFolder {
    id             String   @id @default(cuid())
    userId         String
    page           NotePage
    name           String
    parentFolderId String?
    order          Int      @default(0)
    createdAt      DateTime @default(now())
    updatedAt      DateTime @updatedAt

    // Relations
    user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
    parentFolder NoteFolder?  @relation("NoteFolderHierarchy", fields: [parentFolderId], references: [id], onDelete: Cascade)
    childFolders NoteFolder[] @relation("NoteFolderHierarchy")
    notes        Note[]

    @@index([userId])
    @@index([userId, page])
    @@index([parentFolderId])
}

// Note model - stores user notes; a note is a single document (no separate
// card/list sub-model the way ShuffleList/ShuffleCard has one)
model Note {
    id        String   @id @default(cuid())
    userId    String
    page      NotePage
    title     String
    content   String   @db.Text
    language  String?
    folderId  String?
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // Structured data a tool needs to reopen what it saved — kept out of
    // `content` on purpose (Question 266): `content` is what the user reads
    // and edits, so anything hidden in it is neither hidden (react-markdown
    // renders raw HTML as literal text) nor safe from being edited away.
    //
    // Two columns rather than one so the notes list can tell which notes are
    // resumable without downloading every saved conversation: `metadataKind`
    // is short and always selected, `metadata` holds the payload and is only
    // read when a note is actually opened or resumed.
    metadataKind String?
    metadata     String? @db.Text

    // Relations
    user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
    folder NoteFolder? @relation(fields: [folderId], references: [id], onDelete: Cascade)

    @@index([userId])
    @@index([userId, page])
    @@index([folderId])
    @@index([language])
    @@index([createdAt])
}

// Enum for which page a note (or note folder) belongs to; "general" is the
// standalone Notes page, not tied to any other page
enum NotePage {
    reading
    writing
    vocabulary
    listening
    speaking
    general
}

// User model - stores user information
model User {
    id            String    @id @default(cuid())
    name          String?
    email         String    @unique
    emailVerified DateTime?
    image         String?
    password      String? // For credentials auth
    role          String    @default("user")

    // The language this user wants things translated *into* by default
    // (Question 303) — their own language, in practice. Stored as one of
    // the canonical names in lib/language-codes.ts, the same spelling every
    // language field in this app writes.
    //
    // On the account rather than in the browser, unlike drafts and
    // recently-used languages: those are conveniences for the tab you're
    // in, while this is closer to a fact about the person, and should
    // follow them to a new browser the way their vocabulary already does.
    //
    // Null until set. It only ever supplies a starting value to a
    // "translate into" field — never to a "what language is this" one, and
    // never as something the field can't be changed away from.
    defaultTranslateLanguage String?
    createdAt                DateTime @default(now())
    updatedAt                DateTime @updatedAt

    // NextAuth adapter fields
    accounts Account[]
    sessions Session[]

    // Your existing relations
    folders        Folder[]
    texts          Text[]
    vocabulary     VocabularyEntry[]
    notes          Note[]
    noteFolders    NoteFolder[]
    shuffleLists   ShuffleList[]
    shuffleFolders ShuffleFolder[]

    @@index([email])
}

// NextAuth adapter models
model Account {
    id                String  @id @default(cuid())
    userId            String
    type              String
    provider          String
    providerAccountId String
    refresh_token     String? @db.Text
    access_token      String? @db.Text
    expires_at        Int?
    token_type        String?
    scope             String?
    id_token          String? @db.Text
    session_state     String?

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([provider, providerAccountId])
    @@index([userId])
}

model Session {
    id           String   @id @default(cuid())
    sessionToken String   @unique
    userId       String
    expires      DateTime
    user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
}

model VerificationToken {
    identifier String
    token      String   @unique
    expires    DateTime

    @@unique([identifier, token])
}
