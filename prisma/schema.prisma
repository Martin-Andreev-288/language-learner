// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client-js"
    output   = "../app/generated/prisma"
}

datasource db {
    provider = "postgresql"
}

// Folder model - organises texts and dialogues into user folders
model Folder {
    id        String   @id @default(cuid())
    userId    String
    name      String
    order     Int
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // Relations
    user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
    texts Text[]

    @@index([userId])
    @@index([order])
}

// Text model - stores reading, writing, and dialogue sessions
model Text {
    id         String   @id @default(cuid())
    userId     String
    title      String?
    content    String   @db.Text
    language   String
    type       TextType
    newWords   Int      @default(0)
    totalWords Int      @default(0)
    folderId   String?
    createdAt  DateTime @default(now())

    // Relations
    user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
    folder Folder? @relation(fields: [folderId], references: [id], onDelete: Cascade)

    @@index([userId])
    @@index([folderId])
    @@index([language])
    @@index([type])
    @@index([createdAt])
}

// Enum for text type
enum TextType {
    reading
    writing
    dialogue
}

// SystemDialogue model - global seeded island dialogues (no userId)
model SystemDialogue {
    id        String   @id @default(cuid())
    category  String
    title     String
    content   String   @db.Text
    language  String
    order     Int      @default(0)
    createdAt DateTime @default(now())

    // Unique key for idempotent upsert in seed script
    @@unique([language, category, title])
    @@index([language])
    @@index([category])
    @@index([order])
}

// VocabularyEntry model - tracks words encountered
model VocabularyEntry {
    id               String   @id @default(cuid())
    userId           String
    word             String
    language         String
    timesSeenReading Int      @default(0)
    timesSeenWriting Int      @default(0)
    firstSeen        DateTime @default(now())
    lastSeen         DateTime @updatedAt

    // Relations
    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    // Unique constraint: one entry per word per language per user
    @@unique([userId, word, language])
    @@index([userId])
    @@index([language])
    @@index([word])
}

// ShuffleFolder model - organises shuffle lists into nested, user-created folders (unlimited depth)
model ShuffleFolder {
    id             String          @id @default(cuid())
    userId         String
    type           ShuffleListType
    name           String
    parentFolderId String?
    order          Int             @default(0)
    createdAt      DateTime        @default(now())
    updatedAt      DateTime        @updatedAt

    // Relations
    user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
    parentFolder ShuffleFolder?  @relation("ShuffleFolderHierarchy", fields: [parentFolderId], references: [id], onDelete: Cascade)
    childFolders ShuffleFolder[] @relation("ShuffleFolderHierarchy")
    lists        ShuffleList[]

    @@index([userId])
    @@index([userId, type])
    @@index([parentFolderId])
}

// ShuffleList model - stores user-created vocabulary/phrase lists for shuffle review
model ShuffleList {
    id             String          @id @default(cuid())
    userId         String
    type           ShuffleListType
    title          String
    reviewCount    Int             @default(0)
    lastReviewedAt DateTime?
    folderId       String?
    createdAt      DateTime        @default(now())
    updatedAt      DateTime        @updatedAt

    // Relations
    user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
    folder ShuffleFolder? @relation(fields: [folderId], references: [id], onDelete: Cascade)
    cards  ShuffleCard[]

    @@index([userId])
    @@index([userId, type])
    @@index([folderId])
    @@index([createdAt])
}

// ShuffleCard model - stores card review state inside a shuffle list
model ShuffleCard {
    id        String   @id @default(cuid())
    listId    String
    text      String   @db.Text
    memorized Boolean  @default(false)
    favorite  Boolean  @default(false)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // Relations
    list ShuffleList @relation(fields: [listId], references: [id], onDelete: Cascade)

    @@index([listId])
    @@index([memorized])
    @@index([favorite])
    @@index([createdAt])
}

// Enum for shuffle list types
enum ShuffleListType {
    word
    phrase
}

// Note model - stores user notes
model Note {
    id        String   @id @default(cuid())
    userId    String
    title     String
    content   String   @db.Text
    language  String?
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // Relations
    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
    @@index([language])
    @@index([createdAt])
}

// User model - stores user information
model User {
    id            String    @id @default(cuid())
    name          String?
    email         String    @unique
    emailVerified DateTime?
    image         String?
    password      String? // For credentials auth
    role          String    @default("user")
    createdAt     DateTime  @default(now())
    updatedAt     DateTime  @updatedAt

    // NextAuth adapter fields
    accounts Account[]
    sessions Session[]

    // Your existing relations
    folders        Folder[]
    texts          Text[]
    vocabulary     VocabularyEntry[]
    notes          Note[]
    shuffleLists   ShuffleList[]
    shuffleFolders ShuffleFolder[]

    @@index([email])
}

// NextAuth adapter models
model Account {
    id                String  @id @default(cuid())
    userId            String
    type              String
    provider          String
    providerAccountId String
    refresh_token     String? @db.Text
    access_token      String? @db.Text
    expires_at        Int?
    token_type        String?
    scope             String?
    id_token          String? @db.Text
    session_state     String?

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([provider, providerAccountId])
    @@index([userId])
}

model Session {
    id           String   @id @default(cuid())
    sessionToken String   @unique
    userId       String
    expires      DateTime
    user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
}

model VerificationToken {
    identifier String
    token      String   @unique
    expires    DateTime

    @@unique([identifier, token])
}
