// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client-js"
    output   = "../app/generated/prisma"
}

datasource db {
    provider = "postgresql"
}

// Folder model - organises texts and dialogues into user folders
model Folder {
    id        String   @id @default(cuid())
    userId    String
    name      String
    order     Int
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // Relations
    user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
    texts Text[]

    @@index([userId])
    @@index([order])
}

// Text model - stores reading, writing, and dialogue sessions
model Text {
    id         String   @id @default(cuid())
    userId     String
    title      String?
    content    String   @db.Text
    language   String
    type       TextType
    newWords   Int      @default(0)
    totalWords Int      @default(0)
    folderId   String?
    createdAt  DateTime @default(now())

    // Relations
    user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
    folder Folder? @relation(fields: [folderId], references: [id], onDelete: Cascade)

    @@index([userId])
    @@index([folderId])
    @@index([language])
    @@index([type])
    @@index([createdAt])
}

// Enum for text type
enum TextType {
    reading
    writing
    dialogue
}

// SystemDialogue model - global seeded island dialogues (no userId)
model SystemDialogue {
    id        String   @id @default(cuid())
    category  String
    title     String
    content   String   @db.Text
    language  String
    order     Int      @default(0)
    createdAt DateTime @default(now())

    // Unique key for idempotent upsert in seed script
    @@unique([language, category, title])
    @@index([language])
    @@index([category])
    @@index([order])
}

// VocabularyEntry model - tracks words encountered
model VocabularyEntry {
    id               String   @id @default(cuid())
    userId           String
    word             String
    language         String
    timesSeenReading Int      @default(0)
    timesSeenWriting Int      @default(0)
    firstSeen        DateTime @default(now())
    lastSeen         DateTime @updatedAt

    // Relations
    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    // Unique constraint: one entry per word per language per user
    @@unique([userId, word, language])
    @@index([userId])
    @@index([language])
    @@index([word])
}

// Note model - stores user notes
model Note {
    id        String   @id @default(cuid())
    userId    String
    title     String
    content   String   @db.Text
    language  String?
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // Relations
    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
    @@index([language])
    @@index([createdAt])
}

// User model - stores user information
model User {
    id        String   @id @default(cuid())
    name      String?
    email     String   @unique
    role      String   @default("user")
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // Your existing relations
    folders    Folder[]
    texts      Text[]
    vocabulary VocabularyEntry[]
    notes      Note[]

    @@index([email])
}
